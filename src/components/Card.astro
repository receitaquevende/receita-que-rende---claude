---
/**
 * Card modular. Usado nas grades "o que você aprende", "para quem é", etc.
 */
interface Props {
  n?: string;
  title?: string;
  variant?: 'default' | 'numbered' | 'plain' | 'check';
  class?: string;
  reveal?: boolean;
  revealDelay?: number;
}

const {
  n,
  title,
  variant = 'default',
  class: klass = '',
  reveal = true,
  revealDelay = 0,
} = Astro.props;
---

<article
  class:list={['card', `card--${variant}`, klass]}
  data-reveal={reveal ? '' : undefined}
  style={revealDelay ? `--reveal-delay:${revealDelay}ms` : undefined}
>
  {n && <span class="card__n">{n}</span>}
  {variant === 'check' && (
    <svg class="card__tick" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {title && <h3 class="card__title h3">{title}</h3>}
  <div class="card__body"><slot /></div>
</article>

<style>
  .card {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    box-shadow: var(--shadow-sm);
    transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s var(--ease);
    height: 100%;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--line-strong);
  }

  .card__n {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--brand);
    letter-spacing: .02em;
    margin-bottom: .7rem;
    font-variation-settings: 'SOFT' 20;
  }
  .card--numbered .card__n {
    font-size: 1.5rem;
    line-height: 1;
  }
  .card--numbered .card__n::after {
    content: '';
    display: block;
    width: 22px;
    height: 2px;
    background: var(--brand-tint);
    margin-top: .55rem;
  }

  .card__title {
    color: var(--cocoa);
    margin-bottom: .5rem;
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .card__body {
    color: var(--ink-soft);
    font-size: .96rem;
    line-height: 1.55;
  }

  .card--check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .3rem .85rem;
    align-items: center;
    padding: 1.05rem 1.25rem;
  }
  .card--check .card__tick {
    width: 20px; height: 20px;
    color: var(--brand);
    grid-row: 1 / -1;
  }
  .card--check .card__title { margin: 0; font-size: 1.02rem; }
  .card--check .card__body:empty { display: none; }

  .card--plain {
    background: transparent;
    border: 0;
    box-shadow: none;
    padding: 0;
  }
  .card--plain:hover { transform: none; box-shadow: none; }

  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover { transform: none; transition: none; }
  }
</style>

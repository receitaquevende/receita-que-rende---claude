---
/**
 * Botão de compra — aponta para o link de checkout definido em config.ts.
 * Enquanto o link estiver vazio, o botão rola a página até a oferta,
 * em vez de levar o visitante para lugar nenhum.
 */
import Button from './Button.astro';
import { PRODUCT, hasCheckout } from '../config';

interface Props {
  size?: 'md' | 'lg';
  block?: boolean;
  variant?: 'primary' | 'secondary';
  id?: string;
  location?: string;
  class?: string;
}

const {
  size = 'lg',
  block = false,
  variant = 'primary',
  id,
  location = 'cta',
  class: klass = '',
} = Astro.props;

const label = await Astro.slots.render('default');
---

<div class:list={['cta', klass]}>
  <Button
    href={hasCheckout ? PRODUCT.checkoutUrl : '#oferta'}
    size={size}
    block={block}
    variant={variant}
    arrow
    id={id}
    dataAttrs={{
      'data-cta': location,
      'data-checkout': hasCheckout ? 'ready' : 'pending',
    }}
  >
    <Fragment set:html={label} />
  </Button>
  {!hasCheckout && (
    <p class="cta__pending" hidden data-cta-note>
      Link de checkout ainda não configurado — defina <code>checkoutUrl</code> em <code>src/config.ts</code>.
    </p>
  )}
</div>

<style>
  .cta { display: contents; }
  .cta__pending {
    margin-top: .75rem;
    font-size: .82rem;
    line-height: 1.5;
    color: var(--brand-deep);
    background: var(--brand-wash);
    border: 1px dashed var(--brand-tint);
    border-radius: 10px;
    padding: .6rem .8rem;
  }
  .cta__pending code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .92em;
    background: rgba(255,255,255,.6);
    padding: .1em .35em;
    border-radius: 4px;
  }
</style>

{/* O clique é tratado em src/lib/tracking.ts (delegação única no documento):
    aviso de checkout pendente + evento InitiateCheckout + repasse de UTM. */}

---
/**
 * Grade editorial de imagens. Recebe imagens já importadas (otimizadas pelo Astro).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Shot {
  src: ImageMetadata;
  alt: string;
  feature?: boolean;
}
interface Props {
  shots: Shot[];
  class?: string;
}
const { shots, class: klass = '' } = Astro.props;
---

<div class:list={['gallery', klass]}>
  {shots.map((shot, i) => (
    <figure
      class:list={['gallery__item', shot.feature && 'gallery__item--feature']}
      data-reveal="scale"
      style={`--reveal-delay:${i * 90}ms`}
    >
      <Image
        src={shot.src}
        alt={shot.alt}
        widths={[400, 700, 1000, 1400]}
        sizes="(max-width: 720px) 92vw, (max-width: 1100px) 45vw, 520px"
       
        quality={72}
      />
    </figure>
  ))}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: clamp(.75rem, 2vw, 1.4rem);
  }
  .gallery__item {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--cream-200);
    box-shadow: var(--shadow-md);
    aspect-ratio: 4 / 5;
  }
  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .8s var(--ease);
  }
  .gallery__item:hover :global(img) { transform: scale(1.045); }
  .gallery__item--feature { aspect-ratio: 4 / 5; }

  @media (min-width: 800px) {
    .gallery { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; }
    .gallery__item--feature {
      grid-row: span 2;
      grid-column: span 1;
      aspect-ratio: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery__item :global(img) { transition: none; }
  }
</style>

---
/**
 * Wordmark "Receita Que Rende" — recriado em vetor/tipografia própria.
 * variant: 'full' (linha) · 'stacked' (empilhado, p/ hero e rodapé) · 'mark' (só o coração)
 */
interface Props {
  variant?: 'full' | 'stacked' | 'mark';
  class?: string;
  tone?: 'brand' | 'cream';
  label?: string;
}
const { variant = 'full', class: klass = '', tone = 'brand', label = 'Receita Que Rende' } = Astro.props;
---

<span class:list={['logo', `logo--${variant}`, `logo--${tone}`, klass]} role="img" aria-label={label}>
  <svg class="logo__heart" viewBox="0 0 48 44" fill="none" aria-hidden="true">
    <path
      d="M24 40C24 40 5 28.5 5 15.5C5 9.7 9.6 5 15.3 5C19.2 5 22.6 7.2 24 10.4C25.4 7.2 28.8 5 32.7 5C38.4 5 43 9.7 43 15.5C43 28.5 24 40 24 40Z"
      stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"
    />
    <path class="logo__spark" d="M2 12L6.5 14M46 12L41.5 14M9 4.5L11 8M39 4.5L37 8" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
  </svg>
  {variant !== 'mark' && (
    <span class="logo__words">
      <span class="logo__line1">Receita&nbsp;Que</span>
      <span class="logo__line2">Rende</span>
      <svg class="logo__swash" viewBox="0 0 220 14" fill="none" aria-hidden="true" preserveAspectRatio="none">
        <path d="M4 8C50 2 170 2 216 9" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/>
      </svg>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: .55em;
    line-height: 1;
    color: var(--brand);
  }
  .logo--cream { color: var(--cream-50); }
  .logo--cream .logo__line1 { color: var(--cream-100); }

  .logo__heart {
    width: 1.55em;
    height: auto;
    flex: none;
    color: var(--brand);
    overflow: visible;
  }
  .logo--cream .logo__heart { color: var(--brand-tint); }
  .logo__spark { opacity: .8; }

  .logo__words {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    padding-bottom: .28em;
  }
  .logo__line1 {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: .34em;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--cocoa);
    margin-bottom: .12em;
    margin-left: .18em;
  }
  .logo__line2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1em;
    letter-spacing: .01em;
    color: var(--brand);
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
  }
  .logo__swash {
    position: absolute;
    left: .1em;
    right: 0;
    bottom: 0;
    width: 100%;
    height: .34em;
    color: var(--brand);
  }
  .logo--cream .logo__line2,
  .logo--cream .logo__swash { color: var(--brand-tint); }

  /* — tamanhos por variante — */
  .logo--full { font-size: 1.5rem; }
  .logo--full .logo__words { padding-bottom: .2em; }

  .logo--stacked {
    flex-direction: column;
    gap: .3em;
    font-size: clamp(2.4rem, 1.5rem + 3vw, 3.6rem);
    text-align: center;
  }
  .logo--stacked .logo__heart { width: 1.2em; }
  .logo--stacked .logo__words { align-items: center; }
  .logo--stacked .logo__line1 { font-size: .3em; margin-left: .22em; }

  .logo--mark { font-size: 1rem; }
  .logo--mark .logo__heart { width: 1.6em; }
</style>

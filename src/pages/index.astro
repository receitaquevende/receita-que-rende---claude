---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';

import Hero from '../sections/Hero.astro';
import S02Desire from '../sections/S02Desire.astro';
import S03Technique from '../sections/S03Technique.astro';
import S04Learn from '../sections/S04Learn.astro';
import S05Finish from '../sections/S05Finish.astro';
import S06Process from '../sections/S06Process.astro';
import S07ForWho from '../sections/S07ForWho.astro';
import S08Pricing from '../sections/S08Pricing.astro';
import S09Product from '../sections/S09Product.astro';
import S10Offer from '../sections/S10Offer.astro';
import S11Guarantee from '../sections/S11Guarantee.astro';
import S12Faq from '../sections/S12Faq.astro';
import S13FinalCta from '../sections/S13FinalCta.astro';
---

<Base>
  <Header overHero />
  <main id="conteudo">
    <Hero />
    <S02Desire />
    <S03Technique />
    <S04Learn />
    <S05Finish />
    <S06Process />
    <S07ForWho />
    <S08Pricing />
    <S09Product />
    <S10Offer />
    <S11Guarantee />
    <S12Faq />
    <S13FinalCta />
  </main>
  <Footer />
  <StickyCta />
</Base>

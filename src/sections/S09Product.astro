---
import { Image } from 'astro:assets';
import Section from '../components/Section.astro';
import Logo from '../components/Logo.astro';
import { PRODUCT_SECTION } from '../content';
import cover from '../assets/photos/hero-product-portrait.jpg';
---

<Section id="o-produto" tone="sunken" class="prod">
  <div class="prod__grid">
    <div class="prod__mock" data-reveal="scale">
      <div class="prod__device">
        <div class="prod__cover">
          <Image src={cover} alt="" aria-hidden="true"
            widths={[420, 700]} sizes="(max-width: 900px) 80vw, 380px" quality={72} class="prod__cover-img" />
          <div class="prod__cover-veil"></div>
          <div class="prod__cover-content">
            <Logo variant="stacked" tone="cream" class="prod__logo" />
            <span class="prod__cover-sub">{PRODUCT_SECTION.format}</span>
          </div>
        </div>
      </div>
      <span class="prod__chip prod__chip--a" data-reveal style="--reveal-delay:200ms">Receitas-base</span>
      <span class="prod__chip prod__chip--b" data-reveal style="--reveal-delay:320ms">Cravejado</span>
      <span class="prod__chip prod__chip--c" data-reveal style="--reveal-delay:440ms">Precificação</span>
    </div>

    <div class="prod__copy">
      <span class="eyebrow" data-reveal>{PRODUCT_SECTION.kicker}</span>
      <h2 class="h1" data-reveal style="--reveal-delay:80ms">{PRODUCT_SECTION.title}</h2>
      <p class="prod__tagline serif-italic" data-reveal style="--reveal-delay:140ms">{PRODUCT_SECTION.tagline}</p>
      <p class="lead measure" data-reveal style="--reveal-delay:200ms">{PRODUCT_SECTION.description}</p>

      <ul class="prod__highlights" data-reveal style="--reveal-delay:260ms">
        {PRODUCT_SECTION.highlights.map((h) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {h}
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  .prod__grid {
    display: grid;
    gap: clamp(3rem, 8vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .prod__grid { grid-template-columns: .95fr 1.05fr; }
  }

  .prod__mock {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 2.5rem);
  }
  .prod__device {
    width: min(340px, 78vw);
    aspect-ratio: 3 / 4;
    border-radius: 26px;
    padding: 10px;
    background: linear-gradient(150deg, var(--cream-100), var(--paper));
    box-shadow: var(--shadow-lg), inset 0 0 0 1px hsl(38 40% 100% / .6);
    rotate: -3deg;
  }
  .prod__cover {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 18px;
    overflow: hidden;
    background: var(--cocoa-deep);
  }
  .prod__cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .prod__cover-veil {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, hsl(340 45% 18% / .55), hsl(20 30% 12% / .82));
  }
  .prod__cover-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem;
    text-align: center;
  }
  .prod__logo { font-size: clamp(1.7rem, 1.2rem + 3vw, 2.2rem) !important; }
  .prod__cover-sub {
    font-family: var(--font-sans);
    font-weight: 640;
    font-size: .72rem;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--brand-tint);
  }

  .prod__chip {
    position: absolute;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: .55em 1em;
    font-size: .82rem;
    font-weight: 600;
    color: var(--cocoa);
    box-shadow: var(--shadow-md);
    white-space: nowrap;
  }
  .prod__chip--a { top: 6%; right: 2%; rotate: 4deg; }
  .prod__chip--b { bottom: 20%; left: -2%; rotate: -5deg; }
  .prod__chip--c { bottom: 2%; right: 8%; rotate: 3deg; }

  .prod__tagline {
    font-size: clamp(1.15rem, 1rem + .8vw, 1.5rem);
    color: var(--brand);
    margin: 1rem 0 1.25rem;
  }
  .prod__highlights {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: .75rem 1.4rem;
    max-width: 30rem;
  }
  .prod__highlights li {
    display: flex;
    align-items: center;
    gap: .6rem;
    font-size: .95rem;
    font-weight: 550;
    color: var(--ink);
  }
  .prod__highlights svg { width: 18px; height: 18px; color: var(--brand); flex: none; }

  @media (max-width: 420px) {
    .prod__highlights { grid-template-columns: 1fr; }
  }
</style>
